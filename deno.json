{
  "lock": false,
  "name": "@sveltepod/compiler",
  "exports": "./mod.ts",
  "tasks": {
    "generate": "deno run -A ./compiler.ts",
    "snapshot": "deno task test -- --update",
    "test": "deno test -A",
    "outdated": "deno outdated --latest --update"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.8",
    "svelte": "npm:svelte@^5.16.1",
    "svelte2tsx": "npm:svelte2tsx@^0.7.31",
    "ts-morph": "npm:ts-morph@^25.0.0"
  },
  "exclude": ["svelte2tsx-samples"]
}
